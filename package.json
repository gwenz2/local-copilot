{
  "name": "draftdrion",
  "version": "1.2.0",
  "description": "Local coding workspace by Balajedrion, with reviewed AI edits and your choice of provider",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --dir --win --x64 --publish never",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openuidev/browser-bundle": "0.2.1",
    "@openuidev/lang-core": "1.0.1",
    "axios": "^1.6.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "nodemon": "^3.0.0"
  },
  "author": "Balajedrion",
  "license": "MIT",
  "build": {
    "appId": "io.balajedrion.draftdrion",
    "productName": "Draftdrion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server.js",
      "ai-providers.js",
      "chat-stream.js",
      "obsidian-memory.js",
      "local-state.js",
      "file-management.js",
      "openui-library.json",
      "package.json",
      "LICENSE",
      "!**/.env",
      "!**/.env.*",
      "!**/.apikey",
      "!**/desktop.env",
      "!**/credentials.json",
      "!**/state.json",
      "connections.js",
      "agent-policy.js",
      "agent-tools.js",
      "browser-inspector.js"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Draftdrion-Setup-${version}-${arch}.${ext}"
    }
  }
}
